{
  "format": "vc-profile",
  "format_version": 1,
  "profile": {
    "id": "test_two_stage",
    "name": "確かめ用: 二段 (半押し = A、引き切り = 1 / 9 番も)",
    "note": "半押しを A ボタンと同じ番号 (左 17 / 右 18) に出し、ロックを外したもの。半押しで A、そのまま引き切ると A を押したまま 1 / 9 番も出る (銃の二段トリガー)"
  },
  "settings": {
    "input.trigger_lock": false,
    "input.trigger_haptic": true
  },
  "input": {
    "base": "default",
    "bindings": [
      {
        "input": "left.trigger_half",
        "command": "vjoy_button",
        "args": {
          "button": 17
        }
      },
      {
        "input": "right.trigger_half",
        "command": "vjoy_button",
        "args": {
          "button": 18
        }
      }
    ]
  }
}
