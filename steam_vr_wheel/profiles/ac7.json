{
  "format": "vc-profile",
  "format_version": 1,
  "profile": {
    "id": "ac7",
    "name": "AC7 (実戦用)",
    "note": "test_panels を元にした実戦用の並び (テスト用のわざとの警告は外した)。パネルのボタンはパッドの割り当て (1〜32) の後ろ: 右パネル = 32 + スロットの番号、左パネル = 40 + スロットの番号。ゲームの側で vJoy のボタンを次の項目に割り当てる (AC7 の Input.ini の名前): 9 = Gun (右トリガーの引き切り)、33 = SelectMissiles、34 = SelectSpecialWeapon1、35 = SelectSpecialWeapon2 (この 3 つは hotasmod の項目。あるかは要検証)、36 = Weapon (兵装の切り替え)、37 = Gear、38 = Target、39 = Radar、41 = View、42 = Pause、44 = Flare、46 = MNVR (AC7 に無ければ空き)。vJoy の設定でボタンの数を 46 以上にしておくこと。スロットルは vJoy の RZ を Throttle に。"
  },
  "settings": {},
  "input": {
    "base": "default",
    "unbind": [
      "left.trigger_value",
      "left.trigger_full",
      "left.trigger_touch",
      "right.trigger_value",
      "right.trigger_touch"
    ],
    "bindings": [
      {
        "input": "left.trigger_half",
        "command": "panel_execute",
        "args": {
          "panel": "left_game"
        }
      },
      {
        "input": "right.trigger_half",
        "command": "panel_execute",
        "args": {
          "panel": "right_game"
        }
      }
    ]
  },
  "panels": {
    "left_game": {
      "root": "main",
      "folders": {
        "main": {
          "1": {
            "label": "VIEW",
            "command": "vjoy_button",
            "args": {
              "button": 41
            }
          },
          "2": {
            "label": "PAUSE",
            "command": "vjoy_button",
            "args": {
              "button": 42
            }
          },
          "3": {
            "label": "BRAKE",
            "command": "brake"
          },
          "4": {
            "label": "FLARE",
            "command": "vjoy_button",
            "args": {
              "button": 44
            }
          },
          "5": {
            "label": "CRUISE",
            "command": "cruise"
          },
          "6": {
            "label": "MNVR",
            "command": "vjoy_button",
            "args": {
              "button": 46
            },
            "hud": "mnvr"
          },
          "7": {
            "label": "CONFIG",
            "command": "config"
          },
          "8": {
            "label": "MORE",
            "folder": "more"
          }
        },
        "more": {
          "2": {
            "label": "CRUISE C",
            "command": "cruise",
            "args": {
              "action": "center"
            }
          },
          "3": {
            "label": "CRUISE OFF",
            "command": "cruise",
            "args": {
              "action": "off"
            }
          }
        }
      }
    },
    "right_game": {
      "items": {
        "1": {
          "label": "MISSILE",
          "command": "vjoy_button",
          "args": {
            "button": 33
          }
        },
        "2": {
          "label": "SPT1",
          "command": "vjoy_button",
          "args": {
            "button": 34
          }
        },
        "3": {
          "label": "SPT2",
          "command": "vjoy_button",
          "args": {
            "button": 35
          }
        },
        "4": {
          "label": "WPN",
          "command": "vjoy_button",
          "args": {
            "button": 36
          }
        },
        "5": {
          "label": "GEAR",
          "exec": "trigger",
          "block_a": true,
          "command": "vjoy_button",
          "args": {
            "button": 37
          }
        },
        "6": {
          "label": "TGT",
          "command": "vjoy_button",
          "args": {
            "button": 38
          },
          "latch": false
        },
        "7": {
          "label": "RADAR",
          "command": "vjoy_button",
          "args": {
            "button": 39
          }
        }
      }
    }
  }
}