{
  "format": "vc-profile",
  "format_version": 1,
  "profile": {
    "id": "test_throttle_b",
    "name": "テスト: スロットル B モード (パネルは test_panels と同じ)",
    "note": "test_panels.json と同じパネルで、throttle.mode を B にしたもの (0.1.42)。レバーの 50% より前 = アクセル (SL0)、後ろ = ブレーキ (SL1)。BRAKE の項目のブレーキも SL1 に出す (レバーのブレーキと大きい方)。ニュートラルに止めたいときはセンタークルーズ (CRUISE へ 2 回倒してからダブルクリック)。警告 2 行はわざと"
  },
  "settings": {"throttle.mode": "B", "throttle.b_center_neutral": true},
  "input": {
    "base": "default",
    "unbind": ["left.trigger_value", "left.trigger_full", "left.trigger_touch", "right.trigger_value", "right.trigger_touch"],
    "bindings": [
      {"input": "left.trigger_half", "command": "panel_execute", "args": {"panel": "left_game"}},
      {"input": "right.trigger_half", "command": "panel_execute", "args": {"panel": "right_game"}}
    ]
  },
  "panels": {
    "left_game": {
      "root": "main",
      "folders": {
        "main": {
          "0": {"label": "無効 (警告して捨てる)"},
          "1": {"label": "SELECT", "command": "vjoy_button", "args": {"button": 20}},
          "2": {"label": "PAUSE", "command": "vjoy_button", "args": {"button": 21}},
          "3": {"label": "BRAKE", "command": "brake"},
          "4": {"label": "FLARE", "command": "vjoy_button", "args": {"button": 29}},
          "5": {"label": "CRUISE", "command": "cruise"},
          "6": {"label": "MNVR", "command": "vjoy_button", "args": {"button": 23}, "hud": "mnvr"},
          "7": {"label": "CONFIG", "command": "config"},
          "8": {"label": "MORE", "folder": "more"}
        },
        "more": {
          "1": {"label": "この行は予約なので捨てる"},
          "2": {"label": "CRUISE C", "command": "cruise", "args": {"action": "center"}},
          "3": {"label": "CRUISE OFF", "command": "cruise", "args": {"action": "off"}},
          "4": {"label": "BRAKE BTN", "command": "brake", "args": {"method": "button", "button": 28}}
        }
      }
    },
    "right_game": {
      "items": {
        "1": {"label": "MISSILE", "command": "vjoy_button", "args": {"button": 19}},
        "2": {"label": "SPT1", "command": "vjoy_button", "args": {"button": 24}},
        "3": {"label": "SPT2", "command": "vjoy_button", "args": {"button": 25}},
        "4": {"label": "REST", "type": "REST"},
        "5": {"label": "GEAR", "exec": "trigger", "block_a": true, "command": "vjoy_button", "args": {"button": 22}},
        "6": {"label": "TGT", "command": "vjoy_button", "args": {"button": 26}, "latch": false},
        "7": {"label": "RADAR", "command": "vjoy_button", "args": {"button": 27}}
      }
    }
  }
}
