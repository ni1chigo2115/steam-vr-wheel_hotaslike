{
  "format": "vc-profile",
  "format_version": 1,
  "profile": {
    "id": "default",
    "name": "既定 (v0.1.24 と同じ割り当て)",
    "note": "コードの既定の割り当てを全部 JSON で書いたもの。base = none なので、ここに書いた行だけが使われる"
  },
  "settings": {
    "input.trigger_half": 0.25,
    "input.trigger_full": 0.9,
    "input.trigger_release": 0.1,
    "input.trigger_button_from": "analog",
    "input.trigger_mode": "lock",
    "input.trigger_haptic": true
  },
  "input": {
    "base": "none",
    "bindings": [
      {
        "input": "left.trigger_full",
        "command": "vjoy_button",
        "args": {
          "button": 1,
          "press_needs": "trigger_press_button"
        }
      },
      {
        "input": "right.trigger_full",
        "command": "vjoy_button",
        "args": {
          "button": 9,
          "press_needs": "trigger_press_button"
        }
      },
      {
        "input": "left.grip",
        "command": "vjoy_button",
        "args": {
          "button": 2
        }
      },
      {
        "input": "left.menu",
        "command": "vjoy_button",
        "args": {
          "button": 3
        }
      },
      {
        "input": "left.stick_click",
        "command": "vjoy_zone_button",
        "args": {
          "hand": "left"
        }
      },
      {
        "input": "left.a",
        "command": "vjoy_button",
        "args": {
          "button": 17
        }
      },
      {
        "input": "right.grip",
        "command": "vjoy_button",
        "args": {
          "button": 10
        }
      },
      {
        "input": "right.menu",
        "command": "vjoy_button",
        "args": {
          "button": 11
        }
      },
      {
        "input": "right.stick_click",
        "command": "vjoy_zone_button",
        "args": {
          "hand": "right"
        }
      },
      {
        "input": "right.a",
        "command": "vjoy_button",
        "args": {
          "button": 18
        }
      },
      {
        "input": "left.trigger_touch",
        "command": "vjoy_button",
        "args": {
          "button": 31,
          "press_needs": "trigger_pre_press_button"
        }
      },
      {
        "input": "right.trigger_touch",
        "command": "vjoy_button",
        "args": {
          "button": 32,
          "press_needs": "trigger_pre_press_button"
        }
      },
      {
        "input": "left.trigger_value",
        "command": "vjoy_axis",
        "args": {
          "axis": "HID_USAGE_SL0"
        }
      },
      {
        "input": "right.trigger_value",
        "command": "vjoy_axis",
        "args": {
          "axis": "HID_USAGE_SL1"
        }
      },
      {
        "input": "left.pov_mode",
        "command": "vjoy_dpad",
        "args": {
          "buttons": [
            19,
            20,
            21,
            22
          ],
          "pov": 1
        }
      },
      {
        "input": "right.stick_dir",
        "command": "vjoy_dpad",
        "args": {
          "buttons": [
            19,
            20,
            21,
            22
          ],
          "pov": 1
        }
      }
    ]
  }
}
