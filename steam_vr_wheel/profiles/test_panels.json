{
  "format": "vc-profile",
  "format_version": 1,
  "profile": {
    "id": "test_panels",
    "name": "テスト: パネル (01 の既定の並び)",
    "note": "左は 01 の 3.2 の動作テスト用の並び、右は 3.1 の AC8 風の一例。ボタンは確かめ用の仮の番号 (19〜23)。左トリガーはパネルの実行だけ (元の軸 SL0・ボタン 1・触れた 31 は unbind で止める)。右トリガーは半押し = パネルの実行、引き切り = ボタン 9 (GUN) で、元の軸 SL1 と触れた 32 は止める。MNVR は 1 ボタンの仮 (同時押しは args の buttons に番号を並べる)。ボタンの無い項目はコンソールに出るだけ。警告 2 行 ('0' と cruise の '1') はわざと"
  },
  "settings": {},
  "input": {
    "base": "default",
    "unbind": ["left.trigger_value", "left.trigger_full", "left.trigger_touch", "right.trigger_value", "right.trigger_touch"],
    "bindings": [
      {"input": "left.trigger_half", "command": "panel_execute", "args": {"panel": "left_game"}},
      {"input": "right.trigger_half", "command": "panel_execute", "args": {"panel": "right_game"}}
    ]
  },
  "panels": {
    "left_game": {
      "root": "main",
      "folders": {
        "main": {
          "0": {"label": "無効 (警告して捨てる)"},
          "1": {"label": "SELECT", "command": "vjoy_button", "args": {"button": 20}},
          "2": {"label": "PAUSE", "command": "vjoy_button", "args": {"button": 21}},
          "3": {"label": "BRAKE"},
          "4": {"label": "REST", "type": "REST"},
          "5": {"label": "CRUISE", "folder": "cruise"},
          "6": {"label": "MNVR", "command": "vjoy_button", "args": {"button": 23}},
          "7": {"label": "NONE", "type": "NONE"},
          "8": {"label": "CONFIG"}
        },
        "cruise": {
          "1": {"label": "この行は予約なので捨てる"},
          "2": {"label": "CRUISE ON"},
          "3": {"label": "CRUISE OFF"}
        }
      }
    },
    "right_game": {
      "items": {
        "1": {"label": "MISSILE", "command": "vjoy_button", "args": {"button": 19}},
        "2": {"label": "SPT1"},
        "3": {"label": "SPT2"},
        "4": {"label": "REST", "type": "REST"},
        "5": {"label": "GEAR", "exec": "trigger", "block_a": true, "command": "vjoy_button", "args": {"button": 22}},
        "6": {"label": "TGT"},
        "7": {"label": "RADAR"}
      }
    }
  }
}
