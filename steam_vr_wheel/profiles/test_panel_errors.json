{
  "format": "vc-profile",
  "format_version": 1,
  "profile": {
    "id": "test_panel_errors",
    "name": "テスト: パネルのエラーと警告",
    "note": "エラーの確かめ専用。ゲームへは何も出さない (項目はコンソールに出るだけ。左トリガーの元の出力も unbind で止める)。左ルートの 3、SUB の 3、右の 2 は書いていないのでエラーの NONE (赤紫、選べない)。左ルートの 4 は type の NONE (選べない) で見比べ用、2 は REST (選べるが何もしない)。番号を飛ばすと、項目の数より大きい番号は届かなくなる (01 の Q19)。起動時の警告はわざと 5 行: ルートの 0 と 5、SUB の 1 (戻るの予約) と 4、右の 6"
  },
  "settings": {},
  "input": {
    "base": "default",
    "unbind": ["left.trigger_value", "left.trigger_full", "left.trigger_touch"],
    "bindings": [
      {"input": "left.trigger_half", "command": "panel_execute", "args": {"panel": "left_game"}},
      {"input": "right.trigger_half", "command": "panel_execute", "args": {"panel": "right_game"}}
    ]
  },
  "panels": {
    "left_game": {
      "root": "main",
      "folders": {
        "main": {
          "0": {"label": "警告: 0 は書けない"},
          "1": {"label": "SUB", "folder": "sub"},
          "2": {"label": "REST", "type": "REST"},
          "4": {"label": "NONE", "type": "NONE"},
          "5": {"label": "届かない"}
        },
        "sub": {
          "1": {"label": "警告: 戻るの予約"},
          "2": {"label": "OK 2"},
          "4": {"label": "届かない"}
        }
      }
    },
    "right_game": {
      "items": {
        "1": {"label": "OK 1"},
        "3": {"label": "OK 3"},
        "4": {"label": "TRIG 4", "exec": "trigger"},
        "6": {"label": "届かない"}
      }
    }
  }
}
